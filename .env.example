# Copy to .env (or run scripts/init_local.py, which generates a password). Never commit .env.
IFPAY_DB_PASSWORD=change-me
IFPAY_QR_TTL_SECONDS=120
IFPAY_TIMEZONE=UTC
IFPAY_COOKIE_SECURE=false
# Optional overrides:
# IFPAY_SECRET_DIR=./secrets
# IFPAY_INTRAFORGE_CREDENTIAL_FILE=./secrets/intraforge_credential
# IFPAY_INTRAFORGE_VERIFY_MAX_AGE=60
# IFPAY_SESSION_HOURS=8
