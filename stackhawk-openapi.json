      "maxLength": 200,
      "title": "Code"
     }
    },
    "type": "object",
    "required": [
     "code"
    ],
    "title": "CodeBody"
   },
   "CustomerBody": {
    "properties": {
     "username": {
      "type": "string",
      "maxLength": 40,
      "title": "Username"
     },
     "display_name": {
      "type": "string",
      "maxLength": 80,
      "title": "Display Name"
     },
     "password": {
      "type": "string",
      "maxLength": 200,
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "username",
     "display_name",
     "password"
    ],
    "title": "CustomerBody"
   },
   "DecisionBody": {
    "properties": {
     "note": {
      "type": "string",
      "maxLength": 200,
      "title": "Note",
      "default": ""
     }
    },
    "type": "object",
    "title": "DecisionBody"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
